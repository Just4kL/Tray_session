# Сборочные артефакты (~1 ГБ, восстанавливаются через cargo build)
/target
/dist

# Личные данные пользователя — НЕ в репозиторий:
# config.json  — Steam API key, масштаб, позиции окон
# known_games.json — личный список игр
# sessions.db — история игровых сессий
# shortcuts.json — пользовательские шорткаты
/config.json
/known_games.json
/sessions.db
/sessions.db-journal
/shortcuts.json

# Бэкапы 7-Zip (десятки МБ на каждый билд) — хранятся отдельно.
# А сами готовые сборки (TraySession.exe и установщик) теперь в репозитории,
# чтобы их можно было скачать прямо с GitHub.
/*.7z

# Папка загрузки обновлений: создаётся рядом с программой, переживать
# пережитки не нужно — при следующем обновлении перезаписывается.
/update_tmp/
# Файл-сигнал «можно заменять файлы» от основной программы к фоновой.
/update_ready.flag

